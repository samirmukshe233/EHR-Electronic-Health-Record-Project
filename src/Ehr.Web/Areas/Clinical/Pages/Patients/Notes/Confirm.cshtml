@page "/patients/{patientId:guid}/notes/drafts/{draftId:guid}/confirm"
@using Ehr.Domain.Notes
@model Ehr.Web.Areas.Clinical.Pages.Patients.Notes.ConfirmModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    ViewData["Title"] = "Confirm signature";
}
@* The patient, in the banner under the app bar. The note pages read no allergies, so the banner shows none. *@
@section Banner {
    <partial name="_PatientBanner" model="new PatientBanner(Model.Patient, Model.Allergies)" />
}
<div class="sc-pagehead">
    <p><a asp-page="Edit" asp-route-patientId="@Model.Patient.Id" asp-route-draftId="@Model.Draft.Id">Return to editor</a></p>
</div>
<h1>Confirm signature</h1>
<p class="sc-prose">Review the saved note below. Signing makes it a permanent, read-only clinical record.</p>
<partial name="_NoteContent" model="NoteContent.From(Model.Draft)" />
<div id="note-errors" class="sc-notice sc-notice--danger" role="alert" hidden="@(Model.Errors.Count == 0)">
    @foreach (var error in Model.Errors) { <p>@error</p> }
</div>
@if (!OnPrem.IsReachable)
{
    @* UC 2 (Tahseen Arnan): off-site with the clinic's server unreachable, signing couldn't be saved. *@
    <p class="sc-muted">This note can't be signed while the clinic's server can't be reached.</p>
}
else if (Model.Errors.Count == 0)
{
    <form method="post" class="sc-form sc-form--wide" data-note-sign>
        <input type="hidden" asp-for="Version" />
        <label class="sc-check"><input asp-for="Confirmed" /> I have reviewed this note and confirm my signature as @User.Identity?.Name.</label>
        <button class="sc-btn sc-btn--primary">Confirm and sign note</button>
        <p id="note-save-status" class="sc-status" role="status" aria-live="polite"></p>
    </form>
}
<script src="~/_content/Ehr.Design/js/note-editor.js" defer></script>
