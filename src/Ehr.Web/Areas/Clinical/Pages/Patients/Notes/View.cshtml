@page "/patients/{patientId:guid}/notes/{noteId:guid}"
@using Ehr.Domain.Notes
@model Ehr.Web.Areas.Clinical.Pages.Patients.Notes.ViewModel
@{
    ViewData["Title"] = "Signed clinical note";
}
@* The patient, in the banner under the app bar. The note pages read no allergies, so the banner shows none. *@
@section Banner {
    <partial name="_PatientBanner" model="new PatientBanner(Model.Patient, Model.Allergies)" />
}
<div class="sc-pagehead">
    <p><a asp-page="/Patients/Chart" asp-route-id="@Model.Patient.Id">Back to chart</a></p>
</div>
<h1 class="sc-title">Clinical note <span class="sc-tag sc-tag--success">Signed · read-only</span></h1>
<p class="sc-notice sc-notice--success" role="status">This note is signed and permanently saved to the clinical record.</p>
<dl class="record">
    <dt>Signing clinician</dt><dd>@Model.SignerName <small class="mono-id">(@Model.Note.SignerId)</small></dd>
    <dt>Signed</dt><dd><time datetime="@Model.Note.SignedAt.ToString("O")">@Model.Note.SignedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss") UTC</time></dd>
</dl>
<partial name="_NoteContent" model="new NoteContent(Model.Note.History, Model.Note.Assessment, Model.Note.Plan)" />

<partial name="_ReviewHistory" model="Model.CompletedReviews" />
