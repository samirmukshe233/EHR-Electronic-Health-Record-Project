@page "/patients"
@using System.Globalization
@model IndexModel
@{
    ViewData["Title"] = "Patients";
}
<h1>Patients</h1>
@* A plain GET: it works without JavaScript and off-site from the replica, and the results' links carry the criteria
   back from the chart. The fields' names are the query string's. As the clinician types, htmx asks for the results
   alone after a pause, dropping a request still on its way when a newer one starts; Enter or Search submits the form
   as usual. The page's address doesn't follow the typing: htmx would keep copies of the page, names and all, in the
   browser's storage for its history. The arrow keys and "/" are patient-search.js. *@
<form method="get" class="sc-search" role="search"
      hx-get="@Url.Page("Index", "Results")" hx-trigger="input delay:300ms" hx-target="#search-results" hx-sync="this:replace">
    <div class="sc-field">
        <label class="sc-field__label" for="search-name">Name</label>
        <input type="search" name="name" value="@Model.Search.Name" id="search-name" class="sc-field__input" autocomplete="off" autofocus data-search-field aria-keyshortcuts="/">
    </div>
    <div class="sc-field">
        <label class="sc-field__label" for="search-birthdate">Date of birth</label>
        <input type="date" name="birthdate" value="@Model.Search.Birthdate" id="search-birthdate" class="sc-field__input" max="@IndexModel.LatestBirthDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
    </div>
    <div class="sc-field">
        <label class="sc-field__label" for="search-mrn">MRN</label>
        <input type="search" name="mrn" value="@Model.Search.Mrn" id="search-mrn" class="sc-field__input sc-field__input--mono" autocomplete="off">
    </div>
    <button class="sc-btn sc-btn--primary">Search</button>
    <a asp-page="Index" class="sc-btn sc-btn--quiet">Clear</a>
</form>
<div id="search-results">
    <partial name="_SearchResults" model="Model" />
</div>
